<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Merged with the Info.plist Xcode generates from Config/Base.xcconfig.
	  Only keys the INFOPLIST_KEY_* settings cannot express live here.

	  _adb-tls-connect._tcp is what phones with Wireless debugging on
	  advertise; Conduit browses for it to reconnect known phones.

	  _conduit._tcp is Conduit Link's own advert, how Conduit for Android
	  finds this Mac on whatever network they share. MEASURED: left out of
	  this list, macOS refused to advertise it (NoAuth) on every launch, so
	  a phone found the Mac over Wi-Fi only after the cable had told it the
	  Mac's address.
	-->
	<key>NSBonjourServices</key>
	<array>
		<string>_adb-tls-connect._tcp</string>
		<string>_conduit._tcp</string>
	</array>
</dict>
</plist>
